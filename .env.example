POSTGRES_DB=haregi
POSTGRES_USER=haregi
POSTGRES_PASSWORD=haregi
DATABASE_URL=postgresql://haregi:haregi@localhost:5432/haregi
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
API_ORIGIN=http://localhost:4000
LOG_LEVEL=debug
# api の手前に立つプロキシの IP / CIDR(カンマ区切り)。ここに載っている接続元から
# 届いた X-Forwarded-For だけを信用してクライアント IP を決める(未設定なら
# TCP の接続元のみを使い、申告ヘッダーは一切信用しない)。
# 開発は web(Vite dev proxy)が同一ホストのため loopback を指定する。転送先は
# http://localhost:4000 で、node:dns が localhost を ::1 に解決する環境では接続元が
# ::1 になるため、IPv4 / IPv6 の両方を入れる(片方だけだと全員が共通 bucket に潰れる)
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Node プロセスのタイムゾーン。認証テーブルの期限カラムがタイムゾーンなしのため UTC で固定する
# (architecture.md §9)。JST への変換は表示時にのみ行う
TZ=UTC
