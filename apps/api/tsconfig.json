{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    // dev は `node src/index.ts`(型ストリッピング)で動かすため、相対 import に
    // `.ts` 拡張子が必要。build 時は rewriteRelativeImportExtensions が `.js` へ書き換える
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    // 実 DB テストが packages/db の本番 drizzle.config.ts を直接検証する。
    // emit 時の rootDir は tsconfig.build.json で src に限定する。
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
